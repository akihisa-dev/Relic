{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relic Tauri Spike",
  "version": "0.0.0",
  "identifier": "app.relic.desktop.tauri-spike",
  "build": {
    "beforeDevCommand": "pnpm vite --config vite.config.ts --host localhost",
    "beforeBuildCommand": "pnpm vite build --config vite.config.ts",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; object-src 'none'; frame-src data:; base-uri 'none'; form-action 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Relic",
        "width": 1240,
        "height": 820,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": []
  }
}
